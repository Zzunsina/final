{
  "terminal.integrated.profiles.windows": {
    "JobBridge PowerShell": {
      "path": "${env:windir}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoProfile",
        "-NoExit",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\dev-shell.ps1"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "JobBridge PowerShell",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.env.windows": {
    "PATH": "${workspaceFolder}\\tools\\bin;${env:PATH}"
  }
}
